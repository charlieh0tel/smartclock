#!/bin/sh
# Creates the service account the units run as, and group temper.
set -e

case "$1" in
configure)
    if ! getent passwd smartclockd >/dev/null; then
        adduser --system --group --no-create-home \
            --home /var/lib/smartclockd \
            --gecos "SmartClock logging daemon" \
            smartclockd
    fi
    # The receiver's serial port is owned by the dialout group.
    if getent group dialout >/dev/null; then
        adduser smartclockd dialout || true
    fi
    # smartclock-sensord.service joins group temper, and systemd will
    # not start a unit naming a group that does not exist.  The temper
    # package makes it, with its udev rules; it is only recommended, so
    # without it the group is made here, empty of devices.  temper's own
    # postinst checks first in the same way, so either order works.
    if ! getent group temper >/dev/null; then
        addgroup --system temper
    fi
    # The units' StateDirectory= makes these only when a service first
    # starts; made here, with the same owner and mode, a log can be put
    # in place, or read, before then.
    install -d -o smartclockd -g smartclockd -m 0750 \
        /var/lib/smartclockd /var/lib/smartclock-sensord
    ;;
esac

#DEBHELPER#

# cargo-deb restarts the units it is told of by name, but the daemon is
# a template, so its running instances are restarted here, after the
# daemon-reload above.  try-restart leaves a stopped one stopped: an
# instance stopped to copy its log first is not started by the upgrade.
if [ "$1" = "configure" ] && [ -n "$2" ] && [ -d /run/systemd/system ]; then
    systemctl try-restart 'smartclockd@*.service' >/dev/null || true
fi

exit 0
